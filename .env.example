# Copy to .env and fill in real values. .env is gitignored; never commit secrets.

# Chat completion endpoint (src/llm.py: port 1033 by default)
UNI_API_KEY=replace-with-chat-api-key
UNI_BASE_URL=https://your-llm-host.example:1033/v1
UNI_MODEL_NAME=Qwen/Qwen3-8B

# Optional OpenAI-compatible aliases (take precedence when set)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=
# SSL_CERT_FILE=certs/vm05-ca.crt

# Embedding endpoint (src/llm.py: port 1035 by default)
EMBEDDING_API_KEY=replace-with-embedding-api-key
EMBEDDING_BASE_URL=https://your-embedding-host.example:1035/v1
EMBEDDING_MODEL=bge-small-en-v1.5
# EMBEDDING_CERT_PATH=certs/vm02-ca.crt

# Set to 0 to fail instead of falling back to deterministic local hash embeddings
EMBEDDINGS_LOCAL_FALLBACK=1
